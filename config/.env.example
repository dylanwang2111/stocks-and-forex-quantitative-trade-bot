# ──────────────────────────────────────────────
# Trade Bot — Environment Variables Example
# Copy to config/.env (or project root .env)
# and fill in your actual keys.
# ──────────────────────────────────────────────

# ── Interactive Brokers (IBKR) ─────────────────
# Requires TWS or IB Gateway running locally.
# Paper trading port: 4002  |  Live trading port: 4001
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_ID=your_ibkr_account_id_here   # e.g. DU1234567 (paper) or U1234567 (live)

# ── OANDA (Forex) ──────────────────────────────
OANDA_API_KEY=your_oanda_api_key_here
OANDA_ACCOUNT_ID=your_oanda_account_id_here
OANDA_ENVIRONMENT=practice   # practice | live

# ── Groq (free LLM — Llama 3.3 70B) ───────────
GROQ_API_KEY=your_groq_api_key_here

# ── Google Gemini Flash 2.0 (news analysis) ────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Database ───────────────────────────────────
# SQLite for dev (default). Change to postgres:// for prod.
DATABASE_URL=sqlite:///trade_bot.db

# ── Bot Behaviour ──────────────────────────────
# Set to "paper" during testing, "live" when ready
TRADING_MODE=paper

# Minimum confidence score to trade (0–100)
MIN_CONFIDENCE=55

# Max simultaneous positions open at an entry
MAX_POSITIONS=10

# Cash reserve as a fraction of total capital (e.g. 0.30 = 30%)
CASH_RESERVE_PCT=0.20

# Total capital (USD) — sum of both broker accounts
TOTAL_CAPITAL=2000
# Per-broker capital: actual account balance in each broker.
# Stocks sized against IBKR pool, forex sized against OANDA pool independently.
# If not set (0), both fall back to TOTAL_CAPITAL as a single unified pool.
IBKR_CAPITAL=1400
OANDA_CAPITAL=600

#  If you don't set them, it falls back to TOTAL_CAPITAL as a unified pool — fully backward compatible.

# Risk per trade (fraction of capital, e.g. 0.01 = 1%)
RISK_PER_TRADE=0.01

# Max days to hold before forced time-exit (trailing stop usually exits sooner)
SWING_HOLDING_DAYS=7  # default; raise to 10+ for slower swing strategies

# Max stocks selected into active universe (PortfolioAgent + PreScreenAgent)
MAX_STOCKS=6
# Max forex pairs selected into active universe (EURUSD always force-included)
MAX_FOREX=2

# ── Telegram Notifications ─────────────────────
# 1. Create a bot via @BotFather → copy the token
# 2. Send /start to your bot, then run:
#    curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
#    to get your chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Logging ────────────────────────────────────
LOG_LEVEL=INFO   # DEBUG | INFO | WARNING | ERROR

