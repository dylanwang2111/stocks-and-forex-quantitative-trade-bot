# ──────────────────────────────────────────────────────────────────────────────
# Trade Bot — Environment Variables
# Copy this file to .env and fill in your actual values.
# .env is gitignored and will never be committed.
# ──────────────────────────────────────────────────────────────────────────────

# ── Interactive Brokers (IBKR) ────────────────────────────────────────────────
# Requires TWS or IB Gateway running locally.
# Paper trading port: 7497  |  Live trading port: 7496
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_ID=          # e.g. DU1234567 (paper) or U1234567 (live)

# ── OANDA (Forex) ─────────────────────────────────────────────────────────────
OANDA_API_KEY=             # Get from OANDA developer portal
OANDA_ACCOUNT_ID=          # e.g. 101-002-XXXXXXX-001
OANDA_ENVIRONMENT=practice # practice | live

# ── LLM — Groq (free tier, Llama 3.3 70B) ───────────────────────────────────
# Sign up free at https://console.groq.com
GROQ_API_KEY=

# ── LLM — Google Gemini Flash 2.0 (news analysis) ───────────────────────────
# Sign up free at https://aistudio.google.com
GEMINI_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite for dev (default). Switch to PostgreSQL for production.
DATABASE_URL=sqlite:///trade_bot.db
# DATABASE_URL=postgresql://user:password@localhost:5432/tradebot

# ── Bot Behaviour ─────────────────────────────────────────────────────────────
TRADING_MODE=paper         # paper | live
MIN_CONFIDENCE=55          # Minimum score to enter a trade (0–100)
MAX_POSITIONS=2            # Maximum simultaneous open positions
CASH_RESERVE_PCT=0.30      # Fraction of capital always kept as cash (0.30 = 30%)
TOTAL_CAPITAL=500          # Total account capital in USD
RISK_PER_TRADE=0.01        # Max risk per trade as fraction of capital (0.01 = 1%)

# ── Telegram Notifications (optional) ────────────────────────────────────────
# 1. Create a bot via @BotFather and copy the token
# 2. Send /start to your bot, then:
#    curl "https://api.telegram.org/bot<TOKEN>/getUpdates"  → copy chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR
